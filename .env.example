# 複製成 .env 後填入。所有後端都用 OpenAI 相容格式（OpenAI、OpenRouter、xAI、Ollama、LM Studio 都可以）。
# 設成 LLM_PROVIDER=mock 可以不接模型先測介面。

# ---- 日常聊天模型 ----
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=gpt-4o-mini

# 本機 Ollama 範例：
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:14b

# ---- 成人模式模型（選填，留空則不提供成人模式）----
# 請自行確認所選服務的使用條款允許成人內容。
MATURE_BASE_URL=
MATURE_API_KEY=
MATURE_MODEL=

# ---- 其他 ----
PORT=8000
MAX_CONTEXT_MESSAGES=30
